   "source": [
    "# create a function that takes a city name, crime, and year and plots a time series of the crime in that city for that year\n",
    "\n",
    "def plot_crime_time_series(city, crime, year):\n",
    "    # select only the 'Larceny' data for the given city and year and shape it for plotting\n",
    "    if crime in Crime_combined.columns:\n",
    "        subset = Crime_combined[(Crime_combined['City'] == city)].copy()\n",
    "        data = subset[crime]\n",
    "    else: return -1\n",
    "\n",
    "    # plot the time series\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    plt.plot(data['Year'], data[crime], marker='o')\n",
    "    plt.title(f'Time Series of {crime} in {city} for {year}')\n",
    "    plt.xlabel('Month')\n",
    "    plt.ylabel('Number of Offenses')\n",
    "    plt.grid()\n",
    "    plt.show()\n",
    "\n",
    "plot_crime_time_series('Boston', 'Arson', 2022)"
   ]
  },
