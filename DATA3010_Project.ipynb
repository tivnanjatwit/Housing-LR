    "sns.violinplot(data=marketData_2020, x='MONTH', y='AVG_SALE_TO_LIST')\n",
    "plt.title('Distribution of Average Sale to List Ratio by Month in 2020')\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Average Sale to List Ratio')\n",
    "plt.tight_layout()\n",
    "plt.show()"
