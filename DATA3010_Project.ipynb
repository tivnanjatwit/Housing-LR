    "# plot a scatter plot in seaborn of AVG_SALE_TO_LIST vs DATE, using YYYY-MM-DD format for the BEGIN_PERIOD column\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
