    "plt.title('Average Sale to List Ratio in 2020')\n",
    "plt.xlabel('Date')\n",
    "plt.ylabel('Average Sale to List Ratio')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
